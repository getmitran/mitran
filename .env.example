# Mitran Environment Configuration
# Copy to .env and fill in values

# Engine
MITRAN_PORT=7780
MITRAN_DATA_DIR=./data
MITRAN_JWT_SECRET=change-me-to-a-random-string

# AWS (for Bedrock LLM)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# GitHub Integration
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_REPO=

# Slack Integration
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
