# Mitran Environment Configuration
# Copy to .env and fill in values

# Engine
MITRAN_PORT=7780
MITRAN_DATA_DIR=./data
MITRAN_ENV=development

# Auth / Sessions
# MITRAN_SESSION_SECRET signs browser session cookies (HMAC-SHA256)
MITRAN_SESSION_SECRET=change-me-to-random-32-chars
# MITRAN_JWT_SECRET verifies JWT tokens for API auth
MITRAN_JWT_SECRET=change-me-for-jwt

# LLM Provider (options: bedrock|openai|anthropic|ollama|mock)
MITRAN_LLM_PROVIDER=bedrock
# Ollama (only needed when MITRAN_LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434

# AWS (for Bedrock LLM)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# GitHub Integration
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_REPO=

# Slack Integration
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
